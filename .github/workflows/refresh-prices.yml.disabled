name: Refresh Yahoo prices

# Trigger: manual (workflow_dispatch) only. The site's primary scheduler is
# cron-job.org, which POSTs to GitHub's workflow_dispatch endpoint on its
# own schedule (every 15 min, Mon-Fri, market hours UTC). Reliable timing
# AND it's the single source of trigger truth — no double-fires from a
# parallel GitHub-side schedule cron.
#
# The previous schedule:
#   - cron: '7-57/10 0-21 * * 1-5'
# was disabled because:
#   1. It doubled the deploy count when running alongside cron-job.org,
#      burning Netlify build minutes.
#   2. GitHub's scheduled-workflow throttling made it drift to ~hourly
#      cadence anyway, providing no real reliability benefit.
#
# To re-enable the GitHub schedule (e.g., as a backup if cron-job.org goes
# down), uncomment the schedule block below and pick a cadence:
#   '0 * * * 1-5'           = once an hour Mon-Fri (lightweight backup)
#   '7-57/15 13-21 * * 1-5' = every 15 min during US market hours only

on:
  # schedule:
  #   - cron: '0 * * * 1-5'   # uncomment for hourly backup
  workflow_dispatch:   # allow manual trigger from Actions tab + cron-job.org

permissions:
  contents: write       # we need to push the updated data.js

# If a run is still in flight when the next cron fires, kill the old one.
# Avoids overlapping commits on slow Yahoo days.
concurrency:
  group: refresh-prices
  cancel-in-progress: true

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
          cache-dependency-path: 'scripts/requirements.txt'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          # Pinned versions live in scripts/requirements.txt. Bump there if
          # Yahoo's endpoints change and the pin stops working — yfinance
          # community usually ships a fix within days.
          pip install -r scripts/requirements.txt

      - name: Fetch prices and patch data.js
        run: python scripts/fetch_yahoo.py

      - name: Recalculate Entry/Total/Upside (live scoring)
        # Reads the Current Price just patched, plus Base + Ceiling Target
        # already in data.js, and rewrites Entry/Total/Upside per the
        # 0.6*Base + 0.4*Entry framework. Bucket transitions and
        # ceiling-breach signals are surfaced as alerts in the log.
        run: python scripts/score.py

      # The __lastRefresh timestamp stamp was removed: cron-job.org now
      # provides reliable trigger timing, so we don't need to force a commit
      # on every run. The commit step's `git diff --quiet` skip means no-op
      # cron ticks (no price/score change) won't spam the Git history or
      # consume Netlify build minutes. Keep scripts/stamp_refresh.py around
      # in case we ever want to display "last refreshed X min ago" in the UI
      # — adding it back would be one workflow line.

      - name: Commit and push if data.js changed
        run: |
          if git diff --quiet -- data.js; then
            echo "No price changes; nothing to commit."
            exit 0
          fi
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add data.js
          git commit -m "prices $(date -u +'%Y-%m-%d %H:%M') UTC (yfinance)"

          # Race-aware push: another commit (a parallel bot run, or a human
          # code push) may have landed on main between checkout and now.
          # On rejection, rebase our single commit onto fresh main, taking
          # OUR data.js in any conflict (we hold the freshest Yahoo prices),
          # and try again. Bounded retry so we never loop forever.
          for attempt in 1 2 3 4 5; do
            if git push; then
              echo "Push succeeded on attempt $attempt."
              exit 0
            fi
            echo "Push rejected on attempt $attempt; rebasing on origin/main."
            git fetch origin main
            # In rebase semantics, 'theirs' = the commit being replayed (ours).
            # So '-X theirs' keeps our data.js when conflicts occur.
            if ! git rebase -X theirs origin/main; then
              echo "Rebase had unresolvable conflict; aborting and giving up."
              git rebase --abort || true
              exit 1
            fi
          done
          echo "Push still failing after 5 attempts; giving up. Next cron tick will retry."
          exit 1
